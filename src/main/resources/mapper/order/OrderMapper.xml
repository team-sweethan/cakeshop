<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cakeshop.domain.order.mapper.OrderMapper">
    <!-- 작업 규칙: 컬럼을 명시하고 모든 사용자 입력은 #{}로 바인딩한다. -->
    <resultMap id="orderResultMap" type="com.cakeshop.domain.order.entity.Order">
        <id property="id" column="id"/>
        <result property="orderNumber" column="order_number"/>
        <result property="memberId" column="member_id"/>
        <result property="ordererName" column="orderer_name"/>
        <result property="ordererPhone" column="orderer_phone"/>
        <result property="pickupName" column="pickup_name"/>
        <result property="pickupPhone" column="pickup_phone"/>
        <result property="originalAmount" column="original_amount"/>
        <result property="discountAmount" column="discount_amount"/>
        <result property="finalAmount" column="final_amount"/>
        <result property="status" column="status"
                javaType="com.cakeshop.domain.order.entity.OrderStatus"/>
        <result property="pickupAt" column="pickup_at"/>
        <result property="cancellationBlockedAt" column="cancellation_blocked_at"/>
        <result property="paymentExpiresAt" column="payment_expires_at"/>
        <result property="requestMessage" column="request_message"/>
        <result property="rejectReason" column="reject_reason"/>
        <result property="underReviewAt" column="under_review_at"/>
        <result property="rejectedAt" column="rejected_at"/>
        <result property="readyAt" column="ready_at"/>
        <result property="pickedUpAt" column="picked_up_at"/>
        <result property="expiredAt" column="expired_at"/>
        <result property="canceledAt" column="canceled_at"/>
        <result property="cancelReason" column="cancel_reason"/>
        <result property="canceledBy" column="canceled_by"/>
        <result property="pickupReminderSentAt" column="pickup_reminder_sent_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- Mapper 인터페이스에 조회·저장 메서드를 추가할 때 이 resultMap을 사용한다. -->
</mapper>
