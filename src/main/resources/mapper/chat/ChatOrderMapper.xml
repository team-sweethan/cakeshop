<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cakeshop.domain.chat.mapper.ChatOrderMapper">

    <!-- 주문 목록에서 재진입할 관리자 채팅방의 권위 있는 고객 식별자 조회 -->
    <select id="findRoomById" resultType="com.cakeshop.domain.chat.dto.view.ChatOrderRoomView">
        SELECT
            id AS chatRoomId,
            customer_id AS customerId
        FROM chat_rooms
        WHERE id = #{chatRoomId}
    </select>
</mapper>
