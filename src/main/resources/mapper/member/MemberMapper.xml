<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cakeshop.domain.member.mapper.MemberMapper">
    <resultMap id="memberResultMap" type="com.cakeshop.domain.member.entity.Member">
        <id property="id" column="id"/>
        <result property="email" column="email"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="role" column="role"/>
        <result property="createdAt" column="created_at"/>
        <result property="name" column="name"/>
    </resultMap>

    <!-- 인증 입력도 문자열 치환 없이 #{}로 바인딩한다. -->
    <select id="findByEmail" resultMap="memberResultMap">
        SELECT id, email, password, nickname, role, created_at, phone, name
          FROM members
         WHERE email = #{email}
    </select>

    <insert id="join" parameterType="com.cakeshop.domain.member.entity.Member">
        INSERT INTO members (email, password, nickname, role, name, created_at, phone)
        VALUES (#{email}, #{password}, #{nickname}, #{role}, #{name}, NOW(), #{phone})
    </insert>

    <update id="update" parameterType="com.cakeshop.domain.member.entity.Member">
        UPDATE members
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="password != null">password = #{password},</if>
            updated_at = NOW() <!-- 수정 시간을 현재 시간으로 갱신 -->
        </set>
        WHERE id = #{id}
    </update>
</mapper>
