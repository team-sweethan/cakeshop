<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
******************************
작성자 : 김민정
담당자 : 수민
작성일 : 2026-08-18
기능 : 알림용 수신 회원 및 관리자 조회 SQL
설명 : MemberNotificationQueryService가 사용하는 읽기 전용 회원 활성 상태(ACTIVE) 및 활성 관리자 ID 목록 조회를 둔다.
******************************
-->
<mapper namespace="com.cakeshop.domain.member.mapper.MemberNotificationMapper">

    <!-- 수신 회원의 계정 활성 상태(ACTIVE) 여부 확인 -->
    <select id="isMemberActive" resultType="boolean">
        SELECT EXISTS (
            SELECT true FROM members
            WHERE id = #{memberId} AND status = 'ACTIVE'
            LIMIT 1
        )
    </select>

    <!-- 활성화된 관리자 회원 ID 목록 조회 -->
    <select id="findActiveAdminIds" resultType="long">
        SELECT id
        FROM members
        WHERE role = 'ADMIN' AND status = 'ACTIVE'
    </select>

</mapper>
