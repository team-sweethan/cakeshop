기능 : 후기 작성자 표기용 회원 조회 SQL
설명 : MemberReviewQueryService 가 쓰는 읽기 전용 조회만 둔다.
******************************
-->
<mapper namespace="com.cakeshop.domain.member.mapper.MemberReviewMapper">

    <select id="findMembersByIds"
            resultType="com.cakeshop.domain.member.dto.view.MemberReviewView">

        SELECT id,
               nickname,
               (status = 'WITHDRAWN') AS withdrawn
          FROM members
         WHERE id IN
        <foreach collection="memberIds" item="memberId" open="(" separator="," close=")">
            #{memberId}
        </foreach>
    </select>
</mapper>
