<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cakeshop.domain.product.mapper.ProductMapper">

    <!--
        고객 상품 목록 조회와 전체 개수 조회에서
        공통으로 사용하는 검색 조건.
    -->
    <sql id="publicProductConditions">
        WHERE p.status = 'ACTIVE'

        <!-- 상품명 검색 -->
        <if test="condition.keyword != null
                  and !condition.keyword.trim().isEmpty()">
            AND p.name LIKE CONCAT(
            '%',
            TRIM(#{condition.keyword}),
            '%'
            )
        </if>

        <!-- 상품 유형 필터 -->
        <if test="condition.type != null">
            AND p.product_type = #{condition.type}
        </if>

        <!-- 최소 가격 -->
        <if test="condition.minPrice != null">
            AND p.base_price
            <![CDATA[ >= ]]>
            #{condition.minPrice}
        </if>

        <!-- 최대 가격 -->
        <if test="condition.maxPrice != null">
            AND p.base_price
            <![CDATA[ <= ]]>
            #{condition.maxPrice}
        </if>

        <!-- 재고 상태 -->
        <if test="condition.stock != null">
            <choose>
                <!-- 재고 제한이 없거나 재고가 남은 상품 -->
                <when test="condition.stock.name() == 'AVAILABLE'">
                    AND (
                    p.stock_quantity IS NULL
                    OR p.stock_quantity
                    <![CDATA[ > ]]>
                    0
                    )
                </when>

                <!-- 품절 상품 -->
                <when test="condition.stock.name() == 'OUT_OF_STOCK'">
                    AND p.stock_quantity = 0
                </when>
            </choose>
        </if>

        <!-- 당일 픽업 가능한 상품 -->
        <if test="condition.sameDay">
            AND p.preparation_days = 0
        </if>
    </sql>

    <!-- 고객 상품 목록 조회 -->
    <select id="findPublicProducts"
            resultType="com.cakeshop.domain.product.customer.dto.view.ProductListView">

        SELECT
        p.id,
        p.name,
        p.base_price,
        p.product_type,
        p.stock_quantity,
        p.preparation_days,
        p.average_rating,
        p.review_count,

        <!--
            현재 DB에 product_images 테이블이 없으므로
            대표 이미지 URL은 null로 반환한다.
        -->
        NULL AS thumbnail_url

        FROM products p

        <include refid="publicProductConditions"/>

        <!-- 허용된 정렬 조건만 선택한다. -->
        <choose>
            <!-- 최신순 -->
            <when test="condition.sort != null
                        and condition.sort.name() == 'NEWEST'">
                ORDER BY
                p.created_at DESC,
                p.id DESC
            </when>

            <!-- 가격 낮은순 -->
            <when test="condition.sort != null
                        and condition.sort.name() == 'PRICE_ASC'">
                ORDER BY
                p.base_price ASC,
                p.id DESC
            </when>

            <!-- 가격 높은순 -->
            <when test="condition.sort != null
                        and condition.sort.name() == 'PRICE_DESC'">
                ORDER BY
                p.base_price DESC,
                p.id DESC
            </when>

            <!-- 기본값: 인기순 -->
            <otherwise>
                ORDER BY
                p.review_count DESC,
                p.average_rating DESC,
                p.id DESC
            </otherwise>
        </choose>

        LIMIT #{size}
        OFFSET #{offset}
    </select>

    <!-- 검색 조건에 맞는 전체 상품 개수 조회 -->
    <select id="countPublicProducts"
            resultType="long">

        SELECT COUNT(*)
        FROM products p

        <include refid="publicProductConditions"/>
    </select>

    <!-- 고객 상품 상세 조회 -->
    <select id="findPublicDetailById"
            resultType="com.cakeshop.domain.product.customer.dto.view.ProductDetailView">

        SELECT
            p.id,
            p.category_id,
            c.name AS category_name,
            p.name,
            p.description,
            p.base_price,
            p.stock_quantity,
            p.product_type,
            p.preparation_days,
            p.cancellation_limit_days,
            p.average_rating,
            p.review_count
        FROM products p
                 INNER JOIN categories c
                            ON c.id = p.category_id
        WHERE p.id = #{productId}
          AND p.status = 'ACTIVE'
    </select>

    <!-- 판매 중인 상품의 활성 옵션 조회 -->
    <select id="findPublicOptionRowsByProductId"
            resultType="com.cakeshop.domain.product.customer.dto.view.ProductOptionRow">

        SELECT
            pog.id AS group_id,
            pog.name AS group_name,
            pog.required,
            pog.selection_type,
            po.id AS option_id,
            po.name AS option_name,
            po.additional_price
        FROM products p
        INNER JOIN product_option_groups pog
                ON pog.product_id = p.id
        INNER JOIN product_options po
                ON po.option_group_id = pog.id
               AND po.status = 'ACTIVE'
        WHERE p.id = #{productId}
          AND p.status = 'ACTIVE'
        ORDER BY
            pog.sort_order ASC,
            pog.id ASC,
            po.sort_order ASC,
            po.id ASC
    </select>

    <!-- 관리자 전체 상품 목록 조회 -->
    <select id="findAdminProducts"
            resultType="com.cakeshop.domain.product.admin.dto.view.ProductAdminListView">

        SELECT
            p.id,
            p.name,
            p.product_type AS productType,
            p.base_price AS basePrice,
            p.stock_quantity AS stockQuantity,
            p.status,
            p.created_at AS createdAt
        FROM products p
        ORDER BY
            p.created_at DESC,
            p.id DESC
            LIMIT #{size}
        OFFSET #{offset}
    </select>

    <!-- 관리자 전체 상품 개수 조회 -->
    <select id="countAdminProducts"
            resultType="long">

        SELECT COUNT(*)
        FROM products
    </select>

</mapper>
