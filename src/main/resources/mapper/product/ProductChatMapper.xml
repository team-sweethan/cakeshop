<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cakeshop.domain.product.mapper.ProductChatMapper">

    <!-- 채팅 문의 대상 상품 존재 유무 조회 -->
    <select id="countActiveProductById" resultType="int">
        SELECT COUNT(*)
        FROM products
        WHERE id = #{productId}
    </select>

</mapper>
